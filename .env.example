# ─────────────────────────────────────────────
# Differents — variables de entorno
# DOCUMENTO MODELO 
# ─────────────────────────────────────────────

# Puerto del servidor (en Render)
PORT=3000

# Cadena de conexión a MongoDB.
#  · Local:  mongodb://127.0.0.1:27017/differents
#  · Atlas:  mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/differents?retryWrites=true&w=majority

MONGODB_URI=mongodb://127.0.0.1:27017/differents

# Clave para firmar los tokens JWT.
# Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

JWT_SECRET=aqui_va_una_clave_de_64_caracteres

# Caducidad del token
JWT_EXPIRES_IN=8h

# Rondas de cifrado de contraseñas (10-12 es lo recomendado)
BCRYPT_SALT_ROUNDS=12

# Orígenes permitidos para CORS, separados por comas.
#   CORS_ORIGIN=https://differents.onrender.com
CORS_ORIGIN=*

# Entorno: development | production
NODE_ENV=development
